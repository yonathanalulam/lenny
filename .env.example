DB_URL=jdbc:postgresql://localhost:5432/skilled_services
DB_USERNAME=skilled_services
DB_PASSWORD=local_password
# Required. Generate at least 32 random bytes and Base64-encode them; never commit the value.
JWT_SECRET_BASE64=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
PROTECTED_STORAGE_ROOT=./data/protected
VERIFICATION_MAX_FILE_SIZE_BYTES=10485760
VERIFICATION_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png
POSTING_FEE_AMOUNT=150.00
POSTING_FEE_CURRENCY=ETB
POSTING_FEE_PROVIDER=unavailable
# Optional local-only admin bootstrap. Disabled unless explicitly set to true.
DEV_ADMIN_ENABLED=false
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
# Comma-separated web/Android/iOS OAuth client IDs. Leave blank to disable Google authentication.
GOOGLE_ALLOWED_CLIENT_IDS=
